# Example environment variables for MicroCloud Edge Platform
# Copy this file to .env and customize the values

# =============================================================================
# Cluster Configuration
# =============================================================================

# Cluster settings
CLUSTER_NAME=edge-cloud
CLUSTER_MIN_NODES=3
CLUSTER_MAX_NODES=5

# =============================================================================
# Network Configuration
# =============================================================================

# OVN Network Settings
OVN_NETWORK_NAME=ovn-net
OVN_BRIDGE=br0
OVN_IPV4_RANGE=10.168.1.1/24
DNS_DOMAIN=microcloud.local

# =============================================================================
# Storage Configuration
# =============================================================================

# Storage Settings
STORAGE_POOL_NAME=ceph-pool
STORAGE_DRIVER=ceph
LOCAL_POOL_NAME=local-pool
DEFAULT_STORAGE_POOL=local-pool

# =============================================================================
# LXD Configuration
# =============================================================================

# LXD API Settings
LXD_HTTPS_ADDRESS=0.0.0.0:8443

# Remote access password (SET THIS IN PRODUCTION!)
# LXD_TRUST_PASSWORD=

# =============================================================================
# Ansible Settings (Optional)
# =============================================================================

# Ansible configuration
ANSIBLE_USER=ubuntu
ANSIBLE_SSH_KEY=/path/to/ssh/key

# =============================================================================
# Monitoring Configuration (Optional)
# =============================================================================

# Enable monitoring (true/false)
ENABLE_MONITORING=false

# Prometheus endpoint
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# =============================================================================
# Backup Configuration (Optional)
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=7

# =============================================================================
# Notification Settings (Optional)
# =============================================================================

# Enable notifications (true/false)
NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
EMAIL_RECIPIENT=admin@example.com